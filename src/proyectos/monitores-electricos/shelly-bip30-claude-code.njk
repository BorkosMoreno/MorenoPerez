{% raw %}
<script>
(function () {
  'use strict';

  /* ===================== CONFIGURACIÓN ===================== */
  var API_BASE        = 'https://worker-monitor-shelly-aerotermia.borkosmoreno.workers.dev';
  var REFRESCO_MS     = 60000;    // 60 s como pediste
  var HUECO_MAX_MS    = 120000;   // >2 min => hueco (null)
  var STALE_AVISO_S   = 180;      // >3 min => amarillo
  var STALE_ERROR_S   = 900;      // >15 min => rojo
  var VENTANA_VIVO_MS = 86400000; // 24 h
  var MAX_DIAS        = 7;        // rango máximo del worker

  var COLOR = { aero: '#16a34a', resto: '#2563eb', casa: '#dc2626' };

  /* ===================== ESTADO ===================== */
  var registros   = [];   // [{t, aeroW, aeroWh, casaW, casaWh}]
  var modoUTC     = true;
  var modoVivo    = true;
  var fechaDia    = null; // 'YYYY-MM-DD'
  var grafico     = null;
  var tsUltimoOk  = null;
  var cargando    = false;
  var tmrRefresco = null;
  var nfW   = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
  var nfKWh = new Intl.NumberFormat('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
  var TZ_NAV = (Intl.DateTimeFormat().resolvedOptions().timeZone) || 'local';

  /* ===================== FORMATEO ===================== */
  function fmt(t, opts) {
    var o = Object.assign({}, opts);
    if (modoUTC) o.timeZone = 'UTC';
    return new Intl.DateTimeFormat('es-ES', o).format(new Date(t));
  }

  function fmtHora(t) {
    return Number.isFinite(t) ? fmt(t, {hour:'2-digit',minute:'2-digit',hour12:false}) : '—';
  }

  function fmtFH(t) {
    if (!Number.isFinite(t)) return '—';
    var s = fmt(t, {
      day:'2-digit',month:'2-digit',year:'numeric',
      hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false
    });
    return s + (modoUTC ? ' UTC' : ' (local)');
  }

  function fmtW(v) { return Number.isFinite(v) ? nfW.format(v) + ' W' : '—'; }

  /* ===================== CONVERSIÓN UTC / LOCAL PARA EL EJE X ===================== */
  // chartjs-adapter-date-fns dibuja siempre en hora local del navegador.
  // Para mostrar UTC desplazamos el valor "x" para que el reloj renderizado coincida.
  function aDisplay(rawMs) {
    return modoUTC ? rawMs + new Date(rawMs).getTimezoneOffset() * 60000 : rawMs;
  }
  function aRaw(dispMs) {
    return modoUTC ? dispMs - new Date(dispMs).getTimezoneOffset() * 60000 : dispMs;
  }

  /* ===================== FECHAS ===================== */
  function ymdUTC(epoch) {
    var d = new Date(epoch);
    return d.getUTCFullYear() + '-' + String(d.getUTCMonth()+1).padStart(2,'0') + '-' + String(d.getUTCDate()).padStart(2,'0');
  }

  function sumarDias(ymd, n) {
    var p = ymd.split('-');
    return ymdUTC(Date.UTC(Number(p[0]), Number(p[1])-1, Number(p[2])) + n * 86400000);
  }

  function inicioDiaMs(ymd) {
    var p = ymd.split('-');
    return Date.UTC(Number(p[0]), Number(p[1])-1, Number(p[2]));
  }

  /* ===================== API ===================== */
  function pedirRango(desdeMs, hastaMs) {
    var url = new URL(API_BASE + '/api/range');
    url.searchParams.set('start', new Date(desdeMs).toISOString());
    url.searchParams.set('end',   new Date(hastaMs).toISOString());
    url.searchParams.set('bucket', (hastaMs - desdeMs) <= 48 * 3600000 ? 'raw' : 'auto');
    return fetch(url.toString(), {headers:{'Accept':'application/json'}})
      .then(function(r) { return r.json().catch(function(){return null;}).then(function(j){
        if (!r.ok || !j || j.success !== true) throw new Error((j&&j.error)||('HTTP '+r.status));
        return j;
      });});
  }

  function pedirLatest() {
    return fetch(API_BASE + '/api/latest', {headers:{'Accept':'application/json'}})
      .then(function(r) { return r.json().catch(function(){return null;}).then(function(j){
        if (!r.ok || !j) return null;
        return j;
      });});
  }

  /* ===================== CARGA ===================== */
  function rangoActual() {
    if (modoVivo) {
      var ahora = Date.now();
      return { desde: ahora - VENTANA_VIVO_MS, hasta: ahora };
    }
    var ini = inicioDiaMs(fechaDia);
    return { desde: ini, hasta: ini + 86400000 - 1 };
  }

  function cargarCompleto() {
    if (cargando) return;
    cargando = true;
    mostrarAviso('info', 'Cargando datos…');

    var r = rangoActual();

    Promise.all([pedirRango(r.desde, r.hasta), pedirLatest()])
      .then(function(res) {
        var rango = res[0];
        var latest = res[1];

        // Normalizar: el worker devuelve data[].t
        registros = (rango && Array.isArray(rango.data)) ? rango.data.map(function(d) {
          return { t: d.t, aeroW: d.aeroW, aeroWh: d.aeroWh, casaW: d.casaW, casaWh: d.casaWh };
        }) : [];

        tsUltimoOk = Date.now();

        // Guardar latest para la tarjeta (si viene en rango, usar ese; si no, pedirlo)
        if (rango && rango.latest) {
          window._monLatest = rango.latest;
        } else if (latest && latest.latest) {
          window._monLatest = latest.latest;
        }

        if (registros.length === 0) {
          mostrarAviso('aviso', 'No hay datos para este periodo.');
        } else {
          ocultarAviso();
        }

        reconstruir();
      })
      .catch(function(err) {
        var m = err && err.message ? err.message : String(err);
        if (/failed to fetch|networkerror|load failed/i.test(m)) {
          mostrarAviso('error', 'El Worker no responde. Revisa la conexión o el estado del Worker de Cloudflare.');
        } else {
          mostrarAviso('error', 'Error al obtener los datos: ' + m);
        }
      })
      .then(function() { cargando = false; });
  }

  // Refresco incremental: solo pide datos posteriores al último registro
  function cargarIncremental() {
    if (cargando || !modoVivo) return;
    if (registros.length === 0) { cargarCompleto(); return; }

    var desde = registros[registros.length - 1].t + 1;
    var hasta = Date.now();
    if (hasta <= desde) { pintarEstadoShelly(); return; }

    cargando = true;

    pedirRango(desde, hasta)
      .then(function(rango) {
        if (rango && Array.isArray(rango.data) && rango.data.length > 0) {
          var nuevos = rango.data.map(function(d) {
            return { t: d.t, aeroW: d.aeroW, aeroWh: d.aeroWh, casaW: d.casaW, casaWh: d.casaWh };
          });
          registros = registros.concat(nuevos);
          // Poda: mantener solo 24h
          var corte = Date.now() - VENTANA_VIVO_MS;
          registros = registros.filter(function(x) { return x.t >= corte; });
        }
        if (rango && rango.latest) window._monLatest = rango.latest;
        tsUltimoOk = Date.now();
        reconstruir();
        ocultarAviso();
      })
      .catch(function(err) {
        var m = err && err.message ? err.message : String(err);
        if (/failed to fetch|networkerror/i.test(m)) {
          mostrarAviso('error', 'El Worker no responde.');
        }
      })
      .then(function() { cargando = false; });
  }

  /* ===================== SERIES (con huecos) ===================== */
  function construirSeries() {
    var aero = [], resto = [], casa = [];
    var prev = null;

    registros.forEach(function(r) {
      // Hueco: >2 min entre lecturas => null que rompe la línea
      if (prev !== null && (r.t - prev) > HUECO_MAX_MS) {
        var xh = aDisplay(prev + 60000);
        aero.push({x: xh, y: null});
        resto.push({x: xh, y: null});
        casa.push({x: xh, y: null});
      }

      var x = aDisplay(r.t);
      var a = Number.isFinite(r.aeroW) ? r.aeroW : null;
      var c = Number.isFinite(r.casaW) ? r.casaW : null;

      aero.push({x: x, y: a, t: r.t});
      casa.push({x: x, y: c, t: r.t});
      resto.push({x: x, y: (a === null || c === null) ? null : (c - a), t: r.t});

      prev = r.t;
    });

    return {aero: aero, resto: resto, casa: casa};
  }

  /* ===================== GRÁFICO ===================== */
  function serieBase(etiqueta, color, visible) {
    return {
      label: etiqueta,
      data: [],
      borderColor: color,
      backgroundColor: color,
      borderWidth: 1.6,
      stepped: true,
      pointRadius: 0,
      pointHoverRadius: 3,
      pointHitRadius: 10,
      spanGaps: false,
      tension: 0,
      hidden: !visible
    };
  }

  function crearGrafico() {
    if (typeof Chart === 'undefined') {
      mostrarAviso('error', 'No se ha podido cargar Chart.js desde el CDN.');
      return;
    }
    var ctx = document.getElementById('mon-grafico').getContext('2d');
    grafico = new Chart(ctx, {
      type: 'line',
      data: {
        datasets: [
          serieBase('Aerotermia (W)',     COLOR.aero, true),
          serieBase('Resto vivienda (W)', COLOR.resto, true),
          serieBase('Casa total (W)',    COLOR.casa, true)
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: {mode: 'index', intersect: false},
        scales: {
          x: {
            type: 'time',
            time: {displayFormats: {minute: 'HH:mm', hour: 'HH:mm', day: 'dd/MM'}},
            title: {display: true, text: 'Hora UTC'},
            ticks: {autoSkip: true, maxRotation: 0, maxTicksLimit: 10},
            grid: {color: 'rgba(0,0,0,0.05)'}
          },
          y: {
            suggestedMin: 0,
            title: {display: true, text: 'Potencia (W)'},
            ticks: {callback: function(v) { return nfW.format(v); }},
            grid: {color: 'rgba(0,0,0,0.05)'}
          }
        },
        plugins: {
          legend: {position: 'bottom', labels: {usePointStyle: true, boxWidth: 8}},
          tooltip: {
            callbacks: {
              title: function(items) {
                if (!items.length) return '';
                var t = items[0].raw && items[0].raw.t;
                return Number.isFinite(t) ? fmtFH(t) : '';
              },
              label: function(item) {
                var v = item.parsed.y;
                return item.dataset.label + ': ' + (v === null ? 'sin dato' : nfW.format(v) + ' W');
              }
            }
          },
          zoom: {
            limits: {x: {min: 'original', max: 'original'}},
            pan:  {enabled: true, mode: 'x'},
            zoom: {
              wheel: {enabled: true},
              pinch: {enabled: true},
              mode: 'x'
            }
          }
        }
      }
    });
  }

  /* ===================== ESTADÍSTICAS ===================== */
  function resumen(getter) {
    var n = 0, suma = 0, mn = Infinity, mnT = null, mx = -Infinity, mxT = null;
    registros.forEach(function(r) {
      var v = getter(r);
      if (!Number.isFinite(v)) return;
      n++; suma += v;
      if (v < mn) { mn = v; mnT = r.t; }
      if (v > mx) { mx = v; mxT = r.t; }
    });
    if (n === 0) return null;
    return {n: n, media: suma/n, min: mn, minT: mnT, max: mx, maxT: mxT};
  }

  function energiaKWh(campo) {
    var primero = null, ultimo = null;
    registros.forEach(function(r) {
      var v = r[campo];
      if (!Number.isFinite(v)) return;
      if (primero === null) primero = v;
      ultimo = v;
    });
    if (primero === null || ultimo === null) return null;
    return (ultimo - primero) / 1000;
  }

  function celdaExtremo(valor, t) {
    if (!Number.isFinite(valor)) return '—';
    return nfW.format(valor) + ' W<span class="mon-sub">' + fmtHora(t) + '</span>';
  }

  function celdaKWh(v, fiable) {
    if (v === null || !Number.isFinite(v)) return '—';
    var txt = nfKWh.format(v) + ' kWh';
    if (!fiable) return '<span class="mon-nofiable">' + txt + '<span class="mon-sub">no fiable</span></span>';
    return txt;
  }

  function pintarEstadisticas() {
    var rA = resumen(function(r){ return r.aeroW; });
    var rC = resumen(function(r){ return r.casaW; });
    var rR = resumen(function(r){
      return (Number.isFinite(r.casaW) && Number.isFinite(r.aeroW)) ? (r.casaW - r.aeroW) : NaN;
    });

    var kA = energiaKWh('aeroWh');
    var kC = energiaKWh('casaWh');
    var kR = (kA === null || kC === null) ? null : (kC - kA);
    var fiableA = kA === null || kA >= 0;
    var fiableC = kC === null || kC >= 0;
    var fiableR = fiableA && fiableC;

    [['aero',rA,kA,fiableA],['resto',rR,kR,fiableR],['casa',rC,kC,fiableC]].forEach(function(f) {
      var id = f[0], res = f[1], kwh = f[2], fiable = f[3];
      document.getElementById('mon-st-'+id+'-min').innerHTML = res ? celdaExtremo(res.min, res.minT) : '—';
      document.getElementById('mon-st-'+id+'-max').innerHTML = res ? celdaExtremo(res.max, res.maxT) : '—';
      document.getElementById('mon-st-'+id+'-med').textContent = res ? (nfW.format(res.media)+' W') : '—';
      document.getElementById('mon-st-'+id+'-kwh').innerHTML = celdaKWh(kwh, fiable);
    });

    var nota = document.getElementById('mon-nota-energia');
    if (!fiableA || !fiableC) {
      nota.innerHTML = 'Energía = contador acumulado del Shelly (último - primero). <strong class="mon-nofiable">Valor negativo detectado: el contador pudo reiniciarse.</strong>';
    } else {
      nota.textContent = 'Energía = contador acumulado del Shelly (último - primero del periodo).';
    }
  }

  function pintarTarjetaActual() {
    var latest = window._monLatest;
    if (!latest) return;
    var a = latest.aerotermiaW;
    var c = latest.casaTotalW;
    var d = (Number.isFinite(a) && Number.isFinite(c)) ? (c - a) : null;

    document.getElementById('mon-act-aero').textContent  = fmtW(a);
    document.getElementById('mon-act-resto').textContent = fmtW(d);
    document.getElementById('mon-act-casa').textContent  = fmtW(c);

    var ts = Number(latest.timestamp);
    document.getElementById('mon-act-fecha').textContent = Number.isFinite(ts) ? fmtFH(ts) : '—';
  }

  function pintarEstadoShelly() {
    var caja = document.getElementById('mon-estado-shelly');
    var latest = window._monLatest;
    if (!latest || !Number.isFinite(Number(latest.timestamp))) {
      caja.hidden = true;
      return;
    }

    var t = Number(latest.timestamp);
    var seg = Math.max(0, Math.round((Date.now() - t) / 1000));
    var min = Math.floor(seg / 60);

    caja.hidden = false;
    caja.className = 'mon-estado mon-estado--info';

    if (seg <= STALE_AVISO_S) {
      caja.className = 'mon-estado mon-estado--ok';
      caja.textContent = 'Shelly enviando datos con normalidad (última lectura: ' + fmtHora(t) + (modoUTC ? ' UTC' : ' local') + ').';
    } else if (seg <= STALE_ERROR_S) {
      caja.className = 'mon-estado mon-estado--aviso';
      caja.textContent = 'Sin datos nuevos desde hace ' + min + ' min (última lectura: ' + fmtHora(t) + (modoUTC ? ' UTC' : ' local') + ').';
    } else {
      caja.className = 'mon-estado mon-estado--error';
      caja.textContent = 'El Shelly lleva ' + min + ' minutos sin enviar datos (última lectura: ' + fmtHora(t) + (modoUTC ? ' UTC' : ' local') + ').';
    }
  }

  function pintarContadorRefresco() {
    var el = document.getElementById('mon-actualizado');
    if (tsUltimoOk === null) { el.textContent = 'Sin actualizar todavía'; return; }
    var s = Math.max(0, Math.round((Date.now() - tsUltimoOk) / 1000));
    el.textContent = 'Actualizado hace ' + (s < 60 ? (s+' s') : (Math.floor(s/60)+' min'));
  }

  function pintarPeriodo() {
    var el = document.getElementById('mon-periodo');
    var r = rangoActual();
    if (modoVivo) {
      el.textContent = 'Mostrando: últimas 24 h (' + fmtHora(r.desde) + ' ? ' + fmtHora(r.hasta) + ')';
    } else {
      el.textContent = 'Mostrando: día ' + fechaDia + ' completo en UTC';
    }
  }

  function mostrarAviso(tipo, texto) {
    var el = document.getElementById('mon-aviso');
    el.hidden = false;
    el.className = 'mon-estado mon-estado--' + tipo;
    el.textContent = texto;
  }

  function ocultarAviso() { document.getElementById('mon-aviso').hidden = true; }

  /* ===================== RECONSTRUCCIÓN ===================== */
  function reconstruir() {
    if (grafico) {
      var s = construirSeries();
      grafico.data.datasets[0].data = s.aero;
      grafico.data.datasets[1].data = s.resto;
      grafico.data.datasets[2].data = s.casa;
      grafico.options.scales.x.title.text = modoUTC ? 'Hora UTC' : ('Hora local (' + TZ_NAV + ')');
      grafico.update('none');
    }
    pintarTarjetaActual();
    pintarEstadisticas();
    pintarEstadoShelly();
    pintarPeriodo();
    pintarContadorRefresco();
  }

  /* ===================== EXPORTAR CSV ===================== */
  function exportarCSV() {
    if (registros.length === 0) { mostrarAviso('aviso', 'No hay datos que exportar.'); return; }

    var lineas = ['epoch_ms;fecha_hora_utc;fecha_hora_local;aerotermia_w;resto_vivienda_w;casa_total_w;aerotermia_wh_acum;casa_total_wh_acum'];
    registros.forEach(function(r) {
      var d = new Date(r.t);
      var local = new Intl.DateTimeFormat('es-ES', {
        day:'2-digit',month:'2-digit',year:'numeric',
        hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false
      }).format(d);
      var diff = (Number.isFinite(r.casaW) && Number.isFinite(r.aeroW)) ? (r.casaW - r.aeroW) : NaN;
      var dec = function(v,d){ return Number.isFinite(v) ? v.toFixed(d).replace('.',',') : ''; };
      lineas.push([r.t, d.toISOString(), local, dec(r.aeroW,2), dec(diff,2), dec(r.casaW,2), dec(r.aeroWh,2), dec(r.casaWh,2)].join(';'));
    });

    var nombre = 'shelly-em-' + (modoVivo ? ('ultimas24h-' + ymdUTC(Date.now())) : fechaDia) + '.csv';
    var blob = new Blob(['\uFEFF' + lineas.join('\r\n')], {type:'text/csv;charset=utf-8;'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = nombre;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
  }

  /* ===================== CONTROLADORES ===================== */
  function activar(idActivo, ids) {
    ids.forEach(function(id) {
      document.getElementById(id).classList.toggle('mon-btn--activo', id === idActivo);
    });
  }

  function cambiarZonaHoraria(nuevoUTC) {
    if (nuevoUTC === modoUTC) return;

    // Preservar zoom entre zonas horarias
    var rangoRaw = null;
    if (grafico) {
      var esc = grafico.scales.x;
      if (esc && Number.isFinite(esc.min) && Number.isFinite(esc.max)) {
        rangoRaw = {min: aRaw(esc.min), max: aRaw(esc.max)};
      }
    }

    modoUTC = nuevoUTC;
    activar(modoUTC ? 'mon-tz-utc' : 'mon-tz-local', ['mon-tz-utc', 'mon-tz-local']);
    reconstruir();

    if (rangoRaw && grafico && typeof grafico.zoomScale === 'function') {
      grafico.zoomScale('x', {min: aDisplay(rangoRaw.min), max: aDisplay(rangoRaw.max)}, 'none');
    }
  }

  function irAModoVivo() {
    modoVivo = true;
    fechaDia = ymdUTC(Date.now());
    document.getElementById('mon-fecha').value = fechaDia;
    document.getElementById('mon-vivo').classList.add('mon-btn--activo');
    actualizarBotonesDia();
    programarRefresco();
    cargarCompleto();
  }

  function irADia(ymd) {
    modoVivo = false;
    fechaDia = ymd;
    document.getElementById('mon-fecha').value = ymd;
    document.getElementById('mon-vivo').classList.remove('mon-btn--activo');
    actualizarBotonesDia();
    programarRefresco();
    cargarCompleto();
  }

  function actualizarBotonesDia() {
    var hoy = ymdUTC(Date.now());
    document.getElementById('mon-dia-siguiente').disabled = (!modoVivo && fechaDia >= hoy) || modoVivo;
    document.getElementById('mon-fecha').max = hoy;
  }

  function programarRefresco() {
    if (tmrRefresco) { clearInterval(tmrRefresco); tmrRefresco = null; }
    if (modoVivo) {
      tmrRefresco = setInterval(cargarIncremental, REFRESCO_MS);
    }
  }

  function enlazarControles() {
    document.getElementById('mon-vivo').addEventListener('click', irAModoVivo);

    document.getElementById('mon-dia-anterior').addEventListener('click', function() {
      irADia(sumarDias(fechaDia || ymdUTC(Date.now()), -1));
    });

    document.getElementById('mon-dia-siguiente').addEventListener('click', function() {
      var hoy = ymdUTC(Date.now());
      var sig = sumarDias(fechaDia, 1);
      if (sig > hoy) return;
      irADia(sig);
    });

    document.getElementById('mon-fecha').addEventListener('change', function(e) {
      if (e.target.value) irADia(e.target.value);
    });

    document.getElementById('mon-tz-utc').addEventListener('click', function() { cambiarZonaHoraria(true); });
    document.getElementById('mon-tz-local').addEventListener('click', function() { cambiarZonaHoraria(false); });

    // Checkboxes de series
    ['aero','resto','casa'].forEach(function(id, i) {
      document.getElementById('mon-ver-' + id).addEventListener('change', function(e) {
        if (grafico) grafico.data.datasets[i].hidden = !e.target.checked;
        if (grafico) grafico.update('none');
      });
    });

    document.getElementById('mon-refrescar').addEventListener('click', function() {
      if (modoVivo) cargarIncremental(); else cargarCompleto();
    });

    document.getElementById('mon-zoom-reset').addEventListener('click', function() {
      if (grafico) { grafico.resetZoom(); }
    });

    document.getElementById('mon-csv').addEventListener('click', exportarCSV);

    document.addEventListener('visibilitychange', function() {
      if (!document.hidden && modoVivo) cargarIncremental();
    });
  }

  /* ===================== ARRANQUE ===================== */
  function iniciar() {
    fechaDia = ymdUTC(Date.now());
    document.getElementById('mon-fecha').value = fechaDia;

    enlazarControles();
    actualizarBotonesDia();
    crearGrafico();

    // Contador de tiempo y estado del dispositivo cada segundo
    setInterval(function() {
      pintarContadorRefresco();
      pintarEstadoShelly();
    }, 1000);

    programarRefresco();
    cargarCompleto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }

})();
</script>
