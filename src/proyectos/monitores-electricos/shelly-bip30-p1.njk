<!-- ==========================================================================
   LÓGICA JAVASCRIPT DEL MONITOR (Encapsulada en raw para Eleventy/Nunjucks)
   ========================================================================== -->
{% raw %}
<script>
(function () {
  'use strict';

  /* =========================================================================
     1. CONSTANTES Y CONFIGURACIÓN BASE
     ========================================================================= */
  var WORKER_BASE_URL = 'https://worker-monitor-shelly-aerotermia.borkosmoreno.workers.dev';
  var INTERVALO_REFRESCO_MS = 60000;  // Refresco cada 60 segundos
  var MAX_GAPS_PERMITIDO_MS  = 120000; // > 2 min entre registros genera un corte (null)
  var LIMITE_STALE_AVISO_S  = 180;    // > 3 minutos sin datos (amarillo)
  var LIMITE_STALE_ERROR_S  = 900;    // > 15 minutos sin datos (rojo)

  // 2026-08-09 - CREADO: Zona horaria IANA detectada del navegador (p.ej. "Europe/Madrid").
  // Se usa para etiquetar el modo LOCAL con la localidad real del usuario.
  var ZONA_LOCAL = (Intl.DateTimeFormat().resolvedOptions().timeZone) || 'Local';

  var COLORES = {
    aero: '#16a34a',  // Verde
    resto: '#2563eb', // Azul
    casa: '#dc2626'   // Rojo
  };

  /* =========================================================================
     2. ESTADO INTERNO DE LA APLICACIÓN
     ========================================================================= */
  var estado = {
    modoVivo: true,         // true = Últimas 24h dinámicas; false = Día específico
    fechaSeleccionada: '',  // 'YYYY-MM-DD' en UTC
    modoUTC: true,          // true = Eje en UTC; false = Hora Local del navegador
    registros: [],          // Array ordenado de lecturas: [{ t, aeroW, aeroWh, casaW, casaWh }]
    ultimoRegistro: null,   // Última muestra obtenida del backend
    instanteUltimoOk: null, // Timestamp local del último fetch con éxito
    instanciaGrafico: null,
    temporizadorRefresco: null,
    cargando: false
  };

  /* =========================================================================
     3. FORMATEADORES DE NÚMEROS Y FECHAS
     ========================================================================= */
  var fmtW = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
  var fmtKWh = new Intl.NumberFormat('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });

  // 2026-08-09 - CREADO: Sufijo de zona horaria según el modo activo.
  // En UTC muestra " UTC"; en LOCAL muestra " LOCAL (Europe/Madrid)" (zona del navegador).
  function sufijoZona() {
    return estado.modoUTC ? ' UTC' : (' LOCAL (' + ZONA_LOCAL + ')');
  }

  // Convierte timestamp en texto formateado respetando el conmutador UTC/Local
  function formatearFechaHora(epochMs) {
    if (!Number.isFinite(epochMs)) return '—';
    var opciones = {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false
    };
    if (estado.modoUTC) opciones.timeZone = 'UTC';
    // 2026-08-09 - MODIFICADO: Antes solo añadía " UTC" y dejaba LOCAL sin etiqueta.
    // Ahora añade siempre el sufijo correcto (UTC o LOCAL con la zona IANA).
    return new Intl.DateTimeFormat('es-ES', opciones).format(new Date(epochMs)) + sufijoZona();
  }

  function formatearHoraCorta(epochMs) {
    if (!Number.isFinite(epochMs)) return '—';
    var opciones = { hour: '2-digit', minute: '2-digit', hour12: false };
    if (estado.modoUTC) opciones.timeZone = 'UTC';
    return new Intl.DateTimeFormat('es-ES', opciones).format(new Date(epochMs));
  }

  // Transformación de fechas para corregir el renderizado gráfico de Chart.js Adapter
  function aplicarOffsetZonaHoraria(rawMs) {
    if (!estado.modoUTC) return rawMs;
    // Traslada visualmente la hora UTC para coincidir con la escala del adaptador local
    return rawMs + new Date(rawMs).getTimezoneOffset() * 60000;
  }

  function obtenerHoyUTC() {
    var d = new Date();
    var y = d.getUTCFullYear();
    var m = String(d.getUTCMonth() + 1).padStart(2, '0');
    var dia = String(d.getUTCDate()).padStart(2, '0');
    return y + '-' + m + '-' + dia;
  }

  function sumarDiasAFechaUTC(strYmd, numDias) {
    var partes = strYmd.split('-');
    var base = Date.UTC(Number(partes[0]), Number(partes[1]) - 1, Number(partes[2]));
    var resultante = new Date(base + numDias * 86400000);
    var y = resultante.getUTCFullYear();
    var m = String(resultante.getUTCMonth() + 1).padStart(2, '0');
    var dia = String(resultante.getUTCDate()).padStart(2, '0');
    return y + '-' + m + '-' + dia;
  }

  /* =========================================================================
     4. PETICIONES A LA API DEL WORKER
     ========================================================================= */

  // Realiza la llamada al endpoint /api/range que trae ambos canales en una sola petición
  function consultarRangoWorker(desdeMs, hastaMs) {
    var url = new URL(WORKER_BASE_URL + '/api/range');
    url.searchParams.set('start', new Date(desdeMs).toISOString());
    url.searchParams.set('end', new Date(hastaMs).toISOString());
    url.searchParams.set('bucket', 'auto'); // 1 min para <=48h

    return fetch(url.toString(), { headers: { 'Accept': 'application/json' } })
      .then(function (respuesta) {
        if (!respuesta.ok) {
          throw new Error('HTTP ' + respuesta.status);
        }
        return respuesta.json();
      })
      .then(function (json) {
        if (!json || json.success !== true) {
          throw new Error((json && json.error) ? json.error : 'Respuesta errónea del Worker');
        }
        return json;
      });
  }

  /* =========================================================================
     5. LÓGICA DE CARGA Y PROCESAMIENTO DE DATOS
     ========================================================================= */

  function cargarDatosCompletos() {
    if (estado.cargando) return;
    estado.cargando = true;

    var desdeMs, hastaMs;
    var ahora = Date.now();

    if (estado.modoVivo) {
      desdeMs = ahora - (24 * 3600 * 1000);
      hastaMs = ahora;
    } else {
      var p = estado.fechaSeleccionada.split('-');
      desdeMs = Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2]), 0, 0, 0, 0);
      hastaMs = desdeMs + 86400000 - 1;
    }

    consultarRangoWorker(desdeMs, hastaMs)
      .then(function (res) {
        // Formatear filas recibidas
        estado.registros = (res.data || []).map(function (item) {
          return {
            t: Number(item.t),
            aeroW: item.aeroW,
            aeroWh: item.aeroWh,
            casaW: item.casaW,
            casaWh: item.casaWh
          };
        }).sort(function (a, b) { return a.t - b.t; });

        estado.ultimoRegistro = res.latest || null;
        estado.instanteUltimoOk = Date.now();

        renderizarPantalla();
      })
      .catch(function (error) {
        mostrarErrorConexion(error.message);
      })
      .then(function () {
        estado.cargando = false;
      });
  }

  // Refresco incremental cada 60s en modo vivo (sin parpadeos)
  function cargarRefrescoIncremental() {
    if (estado.cargando || !estado.modoVivo) return;

    if (estado.registros.length === 0) {
      cargarDatosCompletos();
      return;
    }

    var ultimoTs = estado.registros[estado.registros.length - 1].t;
    var desdeMs = ultimoTs + 1;
    var hastaMs = Date.now();

    if (hastaMs <= desdeMs) {
      actualizarBarraEstadoShelly();
      return;
    }

    estado.cargando = true;

    consultarRangoWorker(desdeMs, hastaMs)
      .then(function (res) {
        var nuevos = (res.data || []).map(function (item) {
          return {
            t: Number(item.t),
            aeroW: item.aeroW,
            aeroWh: item.aeroWh,
            casaW: item.casaW,
            casaWh: item.casaWh
          };
        });

        if (nuevos.length > 0) {
          estado.registros = estado.registros.concat(nuevos);
          // Purga registros más antiguos que 24 horas para mantener la ventana limpia
          var corte = Date.now() - (24 * 3600 * 1000);
          estado.registros = estado.registros.filter(function (r) { return r.t >= corte; });
        }

        if (res.latest) {
          estado.ultimoRegistro = res.latest;
        }

        estado.instanteUltimoOk = Date.now();
        renderizarPantalla();
      })
      .catch(function (error) {
        mostrarErrorConexion(error.message);
      })
      .then(function () {
        estado.cargando = false;
      });
  }

  /* =========================================================================
     6. TRANSFORMACIÓN DE SERIES Y DETECCIÓN DE HUECOS (GAPS)
     ========================================================================= */

  // Procesa el array inyectando puntos "null" cuando hay saltos > 2 min entre registros
  function procesarSeriesParaGrafico() {
    var serieAero = [];
    var serieResto = [];
    var serieCasa = [];
    var prevT = null;

    estado.registros.forEach(function (r) {
      // Detección de brecha temporal
      if (prevT !== null && (r.t - prevT) > MAX_GAPS_PERMITIDO_MS) {
        var tHueco = aplicarOffsetZonaHoraria(prevT + 60000);
        serieAero.push({ x: tHueco, y: null });
        serieResto.push({ x: tHueco, y: null });
        serieCasa.push({ x: tHueco, y: null });
      }

      var xDisplay = aplicarOffsetZonaHoraria(r.t);
      var wAero = Number.isFinite(r.aeroW) ? r.aeroW : null;
      var wCasa = Number.isFinite(r.casaW) ? r.casaW : null;
      // Resto vivienda = Casa - Aerotermia (Se mantiene el valor real aunque sea negativo)
      var wResto = (wAero !== null && wCasa !== null) ? (wCasa - wAero) : null;

      serieAero.push({ x: xDisplay, y: wAero, tReal: r.t });
      serieResto.push({ x: xDisplay, y: wResto, tReal: r.t });
      serieCasa.push({ x: xDisplay, y: wCasa, tReal: r.t });

      prevT = r.t;
    });

    return { aero: serieAero, resto: serieResto, casa: serieCasa };
  }

  /* =========================================================================
     7. CONSTRUCCIÓN Y GESTIÓN DE CHART.JS
     ========================================================================= */

  function inicializarGrafico() {
    if (typeof Chart === 'undefined') return;

    var ctx = document.getElementById('p1-canvas-grafico').getContext('2d');

    estado.instanciaGrafico = new Chart(ctx, {
      type: 'line',
      data: {
        datasets: [
          {
            label: 'Aerotermia',
            data: [],
            borderColor: COLORES.aero,
            backgroundColor: COLORES.aero,
            borderWidth: 1.8,
            stepped: true, // Línea escalonada para lecturas discretas por minuto
            pointRadius: 0,
            pointHoverRadius: 4,
            spanGaps: false // Fuerza la rotura visual cuando encuentra un y: null
          },
          {
            label: 'Resto vivienda',
            data: [],
            borderColor: COLORES.resto,
            backgroundColor: COLORES.resto,
            borderWidth: 1.8,
            stepped: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            spanGaps: false
          },
          {
            label: 'Casa Total',
            data: [],
            borderColor: COLORES.casa,
            backgroundColor: COLORES.casa,
            borderWidth: 1.8,
            stepped: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            spanGaps: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: 'index', intersect: false },
        scales: {
          x: {
            type: 'time',
            time: { displayFormats: { minute: 'HH:mm', hour: 'HH:mm', day: 'dd/MM' } },
            title: { display: true, text: 'Tiempo (UTC)' },
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          y: {
            suggestedMin: 0, // Inicia preferentemente en 0 pero permite valores negativos si ocurren
            title: { display: true, text: 'Potencia Instantánea (W)' },
            ticks: { callback: function (v) { return fmtW.format(v) + ' W'; } },
            grid: { color: 'rgba(0,0,0,0.05)' }
          }
        },
        plugins: {
          legend: { display: false }, // Se usan los checkboxes propios como control
          tooltip: {
            callbacks: {
              title: function (items) {
                if (!items.length) return '';
                var tReal = items[0].raw && items[0].raw.tReal;
                return Number.isFinite(tReal) ? formatearFechaHora(tReal) : '';
              },
              label: function (item) {
                var v = item.parsed.y;
                return item.dataset.label + ': ' + (v === null ? 'Sin datos' : fmtW.format(v) + ' W');
              }
            }
          },
          zoom: {
            pan: { enabled: true, mode: 'x' },
            zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' }
          }
        }
      }
    });
  }

  /* =========================================================================
     8. CÁLCULO Y RENDERIZADO DE VISTAS Y TARJETAS
     ========================================================================= */

  function renderizarPantalla() {
    if (!estado.instanciaGrafico) return;

    // A. Actualizar Gráfica
    var series = procesarSeriesParaGrafico();
    estado.instanciaGrafico.data.datasets[0].data = series.aero;
    estado.instanciaGrafico.data.datasets[1].data = series.resto;
    estado.instanciaGrafico.data.datasets[2].data = series.casa;

    // Aplicar visibilidad según checkboxes
    estado.instanciaGrafico.data.datasets[0].hidden = !document.getElementById('p1-chk-aero').checked;
    estado.instanciaGrafico.data.datasets[1].hidden = !document.getElementById('p1-chk-resto').checked;
    estado.instanciaGrafico.data.datasets[2].hidden = !document.getElementById('p1-chk-casa').checked;

    // 2026-08-09 - MODIFICADO: Etiqueta del eje X con zona local completa en modo LOCAL.
    estado.instanciaGrafico.options.scales.x.title.text =
      estado.modoUTC ? 'Tiempo (UTC)' : ('Tiempo (Hora Local - ' + ZONA_LOCAL + ')');
    estado.instanciaGrafico.update('none');

    // B. Tarjeta (A): Situación Actual
    renderizarTarjetaActual();

    // C. Tarjeta (B): Estadísticas
    renderizarTablaEstadisticas();

    // D. Estado de Conexión y Temporizadores
    actualizarBarraEstadoShelly();
    actualizarIndicadorRefresco();
  }

  function renderizarTarjetaActual() {
    if (!estado.ultimoRegistro) {
      document.getElementById('p1-act-aero').textContent = '—';
      document.getElementById('p1-act-resto').textContent = '—';
      document.getElementById('p1-act-casa').textContent = '—';
      document.getElementById('p1-act-fecha').textContent = '—';
      return;
    }

    var rec = estado.ultimoRegistro;
    var wAero = rec.aerotermiaW;
    var wCasa = rec.casaTotalW;
    var wResto = (Number.isFinite(wAero) && Number.isFinite(wCasa)) ? (wCasa - wAero) : null;

    document.getElementById('p1-act-aero').textContent = Number.isFinite(wAero) ? (fmtW.format(wAero) + ' W') : '—';
    document.getElementById('p1-act-resto').textContent = Number.isFinite(wResto) ? (fmtW.format(wResto) + ' W') : '—';
    document.getElementById('p1-act-casa').textContent = Number.isFinite(wCasa) ? (fmtW.format(wCasa) + ' W') : '—';
    document.getElementById('p1-act-fecha').textContent = formatearFechaHora(rec.timestamp);
  }

  function calcularStatsCanal(fnValor) {
    var min = Infinity, minT = null;
    var max = -Infinity, maxT = null;
    var suma = 0, cuenta = 0;

    estado.registros.forEach(function (r) {
      var v = fnValor(r);
      if (!Number.isFinite(v)) return;
      cuenta++;
      suma += v;
      if (v < min) { min = v; minT = r.t; }
      if (v > max) { max = v; maxT = r.t; }
    });

    if (cuenta === 0) return null;
    return { min: min, minT: minT, max: max, maxT: maxT, media: suma / cuenta };
  }

  function calcularEnergiaKWh(propWh) {
    var prim = null, ult = null;
    estado.registros.forEach(function (r) {
      var v = r[propWh];
      if (!Number.isFinite(v)) return;
      if (prim === null) prim = v;
      ult = v;
    });
    if (prim === null || ult === null) return null;
    return (ult - prim) / 1000; // Wh a kWh
  }

  function renderizarTablaEstadisticas() {
    var stAero = calcularStatsCanal(function (r) { return r.aeroW; });
    var stCasa = calcularStatsCanal(function (r) { return r.casaW; });
    var stResto = calcularStatsCanal(function (r) {
      return (Number.isFinite(r.casaW) && Number.isFinite(r.aeroW)) ? (r.casaW - r.aeroW) : NaN;
    });

    var kWhAero = calcularEnergiaKWh('aeroWh');
    var kWhCasa = calcularEnergiaKWh('casaWh');
    var kWhResto = (kWhAero !== null && kWhCasa !== null) ? (kWhCasa - kWhAero) : null;

    pintaFilaStat('aero', stAero, kWhAero);
    pintaFilaStat('resto', stResto, kWhResto);
    pintaFilaStat('casa', stCasa, kWhCasa);

    // Detección de anomalías en contadores (p.ej., reinicio de Shelly)
    var notaEl = document.getElementById('p1-nota-kwh');
    if ((kWhAero !== null && kWhAero < 0) || (kWhCasa !== null && kWhCasa < 0)) {
      notaEl.innerHTML = 'Energía = contador acumulado. <span class="p1-no-fiable">Se detectó un valor negativo (contador reiniciado).</span>';
    } else {
      notaEl.textContent = 'Energía = contador acumulado (último - primero del periodo).';
    }
  }

  function pintaFilaStat(id, st, kWh) {
    var elMin = document.getElementById('p1-st-' + id + '-min');
    var elMax = document.getElementById('p1-st-' + id + '-max');
    var elMed = document.getElementById('p1-st-' + id + '-med');
    var elKWh = document.getElementById('p1-st-' + id + '-kwh');

    if (!st) {
      elMin.textContent = '—'; elMax.textContent = '—'; elMed.textContent = '—'; elKWh.textContent = '—';
      return;
    }

    elMin.innerHTML = fmtW.format(st.min) + ' W <span class="p1-subtexto-tabla">' + formatearHoraCorta(st.minT) + '</span>';
    elMax.innerHTML = fmtW.format(st.max) + ' W <span class="p1-subtexto-tabla">' + formatearHoraCorta(st.maxT) + '</span>';
    elMed.textContent = fmtW.format(st.media) + ' W';

    if (kWh === null) {
      elKWh.textContent = '—';
    } else if (kWh < 0) {
      elKWh.innerHTML = '<span class="p1-no-fiable">' + fmtKWh.format(kWh) + ' kWh</span>';
    } else {
      elKWh.textContent = fmtKWh.format(kWh) + ' kWh';
    }
  }

  function actualizarBarraEstadoShelly() {
    var banner = document.getElementById('p1-estado-shelly');

    if (!estado.ultimoRegistro || !Number.isFinite(estado.ultimoRegistro.timestamp)) {
      banner.className = 'p1-banner-estado p1-banner-estado--aviso';
      banner.textContent = 'No hay datos disponibles en el Worker.';
      return;
    }

    var tsMuestra = estado.ultimoRegistro.timestamp;
    var segsTranscurridos = Math.max(0, Math.round((Date.now() - tsMuestra) / 1000));
    var minsTranscurridos = Math.floor(segsTranscurridos / 60);

    banner.classList.remove('p1-banner-estado--ok', 'p1-banner-estado--aviso', 'p1-banner-estado--error');

    if (segsTranscurridos <= LIMITE_STALE_AVISO_S) {
      banner.classList.add('p1-banner-estado--ok');
      banner.textContent = 'Shelly operando con normalidad. Última lectura: ' + formatearFechaHora(tsMuestra);
    } else if (segsTranscurridos <= LIMITE_STALE_ERROR_S) {
      banner.classList.add('p1-banner-estado--aviso');
      banner.textContent = 'Sin datos nuevos desde hace ' + minsTranscurridos + ' min (última lectura: ' + formatearFechaHora(tsMuestra) + ').';
    } else {
      banner.classList.add('p1-banner-estado--error');
      banner.textContent = 'El Shelly lleva ' + minsTranscurridos + ' minutos sin enviar datos (última lectura: ' + formatearFechaHora(tsMuestra) + ').';
    }
  }

  function actualizarIndicadorRefresco() {
    var el = document.getElementById('p1-indicador-refresco');
    if (!estado.instanteUltimoOk) {
      el.textContent = 'Sin actualizar aún';
      return;
    }
    var s = Math.max(0, Math.round((Date.now() - estado.instanteUltimoOk) / 1000));
    el.textContent = 'Actualizado hace ' + s + ' s';
  }

  function mostrarErrorConexion(msg) {
    var banner = document.getElementById('p1-estado-shelly');
    banner.className = 'p1-banner-estado p1-banner-estado--error';
    banner.textContent = 'Error de conexión: El Worker no responde (' + msg + ').';
  }

  /* =========================================================================
     9. EXPORTACIÓN A CSV
     ========================================================================= */

  function exportarDatosCSV() {
    if (estado.registros.length === 0) {
      alert('No hay datos disponibles para exportar.');
      return;
    }

    var cabecera = ['Timestamp_ms', 'Fecha_UTC', 'Fecha_Local', 'Aerotermia_W', 'Resto_W', 'Casa_Total_W', 'Aerotermia_Wh', 'Casa_Wh'];
    var lineas = [cabecera.join(';')];

    estado.registros.forEach(function (r) {
      var d = new Date(r.t);
      var strISO = d.toISOString();
      var strLocal = d.toLocaleString('es-ES');
      var wResto = (Number.isFinite(r.casaW) && Number.isFinite(r.aeroW)) ? (r.casaW - r.aeroW) : '';

      var fila = [
        r.t,
        strISO,
        '"' + strLocal + '"',
        r.aeroW !== null ? String(r.aeroW).replace('.', ',') : '',
        wResto !== '' ? String(wResto).replace('.', ',') : '',
        r.casaW !== null ? String(r.casaW).replace('.', ',') : '',
        r.aeroWh !== null ? String(r.aeroWh).replace('.', ',') : '',
        r.casaWh !== null ? String(r.casaWh).replace('.', ',') : ''
      ];
      lineas.push(fila.join(';'));
    });

    var blob = new Blob(['\uFEFF' + lineas.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'shelly-em-' + (estado.modoVivo ? 'ultimas-24h' : estado.fechaSeleccionada) + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  /* =========================================================================
     10. CONTROLADORES DE EVENTOS
     ========================================================================= */

  function vincularEventosUI() {
    // Checkboxes de visibilidad de series
    document.getElementById('p1-chk-aero').addEventListener('change', renderizarPantalla);
    document.getElementById('p1-chk-resto').addEventListener('change', renderizarPantalla);
    document.getElementById('p1-chk-casa').addEventListener('change', renderizarPantalla);

    // Conmutador Últimas 24h
    document.getElementById('p1-btn-vivo').addEventListener('click', function () {
      estado.modoVivo = true;
      document.getElementById('p1-btn-vivo').classList.add('p1-btn--activo');
      actualizarControlesFecha();
      cargarDatosCompletos();
    });

    // Navegación por fechas
    var inputFecha = document.getElementById('p1-input-fecha');
    inputFecha.addEventListener('change', function (e) {
      if (!e.target.value) return;
      estado.modoVivo = false;
      estado.fechaSeleccionada = e.target.value;
      document.getElementById('p1-btn-vivo').classList.remove('p1-btn--activo');
      actualizarControlesFecha();
      cargarDatosCompletos();
    });

    document.getElementById('p1-btn-dia-ant').addEventListener('click', function () {
      estado.modoVivo = false;
      estado.fechaSeleccionada = sumarDiasAFechaUTC(estado.fechaSeleccionada, -1);
      inputFecha.value = estado.fechaSeleccionada;
      document.getElementById('p1-btn-vivo').classList.remove('p1-btn--activo');
      actualizarControlesFecha();
      cargarDatosCompletos();
    });

    document.getElementById('p1-btn-dia-sig').addEventListener('click', function () {
      var hoy = obtenerHoyUTC();
      var sig = sumarDiasAFechaUTC(estado.fechaSeleccionada, 1);
      if (sig > hoy) return;
      estado.modoVivo = false;
      estado.fechaSeleccionada = sig;
      inputFecha.value = estado.fechaSeleccionada;
      document.getElementById('p1-btn-vivo').classList.remove('p1-btn--activo');
      actualizarControlesFecha();
      cargarDatosCompletos();
    });

    // Zona Horaria
    document.getElementById('p1-btn-tz-utc').addEventListener('click', function () {
      estado.modoUTC = true;
      document.getElementById('p1-btn-tz-utc').classList.add('p1-btn--activo');
      document.getElementById('p1-btn-tz-local').classList.remove('p1-btn--activo');
      renderizarPantalla();
    });

    document.getElementById('p1-btn-tz-local').addEventListener('click', function () {
      estado.modoUTC = false;
      document.getElementById('p1-btn-tz-local').classList.add('p1-btn--activo');
      document.getElementById('p1-btn-tz-utc').classList.remove('p1-btn--activo');
      renderizarPantalla();
    });

    // Botones de acción
    document.getElementById('p1-btn-reset-zoom').addEventListener('click', function () {
      if (estado.instanciaGrafico) estado.instanciaGrafico.resetZoom();
    });

    document.getElementById('p1-btn-csv').addEventListener('click', exportarDatosCSV);
  }

  function actualizarControlesFecha() {
    var hoy = obtenerHoyUTC();
    var inputFecha = document.getElementById('p1-input-fecha');
    inputFecha.max = hoy;

    if (estado.modoVivo) {
      estado.fechaSeleccionada = hoy;
      inputFecha.value = hoy;
    }

    document.getElementById('p1-btn-dia-sig').disabled = (estado.fechaSeleccionada >= hoy);
  }

  /* =========================================================================
     11. ARRANQUE E INICIALIZACIÓN
     ========================================================================= */

  function inicializar() {
    estado.fechaSeleccionada = obtenerHoyUTC();
    actualizarControlesFecha();

    vincularEventosUI();
    inicializarGrafico();

    // Bucle de refresco secundario (actualiza contador de tiempo y stale timer)
    setInterval(function () {
      actualizarIndicadorRefresco();
      actualizarBarraEstadoShelly();
    }, 1000);

    // Bucle de consulta incremental cada 60 segundos (solo en modo vivo)
    setInterval(function () {
      if (estado.modoVivo) {
        cargarRefrescoIncremental();
      }
    }, INTERVALO_REFRESCO_MS);

    // Carga inicial
    cargarDatosCompletos();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inicializar);
  } else {
    inicializar();
  }

})();
</script>
