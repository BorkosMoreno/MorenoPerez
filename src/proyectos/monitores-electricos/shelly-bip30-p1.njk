              <td id="p1-st-aero-med">—</td>
              <td id="p1-st-aero-kwh">—</td>
            </tr>
            <tr>
              <th scope="row">
                <span class="p1-indicador-color" style="background-color: #2563eb;"></span>Resto
              </th>
              <td id="p1-st-resto-min">—</td>
              <td id="p1-st-resto-max">—</td>
              <td id="p1-st-resto-med">—</td>
              <td id="p1-st-resto-kwh">—</td>
            </tr>
            <tr>
              <th scope="row">
