          <span class="p1-valor-destacado" id="p1-act-casa">— W</span>
        </li>
      </ul>

    </section>

    <!-- TARJETA B: ESTADÍSTICAS DEL PERIODO SELECCIONADO -->
    <section class="p1-tarjeta" aria-labelledby="p1-titulo-stats">

      <!-- 2026-08-09 - CREADO: Cabecera en una sola línea.
