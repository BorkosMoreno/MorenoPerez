---
layout: layouts/base.njk
---
<article class="proyecto-documento container">
  <header class="proyecto-header">
    <span class="proyecto-categoria-etiqueta">{{ categoria }}</span>
    <h1 class="proyecto-titulo">{{ title }}</h1>
    {% if description %}
      <p class="proyecto-sinopsis">{{ description }}</p>
    {% endif %}
  </header>
  
  <hr class="divisor-proyecto">
  
  <div class="proyecto-cuerpo-markdown">
    {{ content | safe }}
  </div>

  <footer class="proyecto-retorno-footer">
    <a href="/index.html#proyectos" class="btn-retorno">← Volver a Proyectos</a>
  </footer>
</article>